# =============================================================================
# Environment variable template — copy this file to .env and fill in values
# .env is listed in .gitignore and must NEVER be committed
# =============================================================================

# --- PostgreSQL (must match docker-compose.yml or your own PostgreSQL setup) --
DB_URL=jdbc:postgresql://localhost:5432/alumnidb
DB_USERNAME=alumniuser
DB_PASSWORD=alumnipass

# Used by docker-compose.yml directly (must match DB_* values above)
POSTGRES_DB=alumnidb
POSTGRES_USER=alumniuser
POSTGRES_PASSWORD=alumnipass

# --- PhantomBuster ------------------------------------------------------------
# Your PhantomBuster workspace API key (Settings → API keys)
PHANTOMBUSTER_API_KEY=your_phantombuster_api_key_here

# PhantomBuster v2 API base URL — change only if using a proxy or enterprise endpoint
PHANTOMBUSTER_BASE_URL=https://api.phantombuster.com/api/v2

# The Agent ID of your pre-configured LinkedIn Search Export Phantom
# Find it: open the Phantom in the PhantomBuster dashboard. The Agent ID is
# the last numeric segment in the URL before /console:
# e.g. https://phantombuster.com/<org_id>/phantoms/<template_id>/<agent_id>/console
PHANTOMBUSTER_AGENT_ID=your_phantom_agent_id_here

# Optional tuning (defaults shown)
PHANTOMBUSTER_POLL_INTERVAL_MS=3000
PHANTOMBUSTER_POLL_MAX_ATTEMPTS=20
