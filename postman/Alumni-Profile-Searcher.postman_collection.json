{
  "info": {
    "name": "Alumni LinkedIn Profile Searcher",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Postman collection for the Alumni LinkedIn Profile Searcher API.\n\nSet the `baseUrl` variable to `http://localhost:8080` before running.\n\nPrerequisites:\n- Application is running (`./mvnw spring-boot:run`)\n- PostgreSQL is running (`docker compose up -d`)\n- PhantomBuster environment variables are set in .env",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Search Alumni",
      "item": [
        {
          "name": "Search Alumni — Valid Request (with passoutYear)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"university\": \"University of XYZ\",\n  \"designation\": \"Software Engineer\",\n  \"passoutYear\": 2020\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/alumni/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alumni", "search"]
            },
            "description": "Searches for Software Engineer alumni from University of XYZ who graduated in 2020.\n\nExpected: 200 OK with matched alumni profiles in data array."
          },
          "response": []
        },
        {
          "name": "Search Alumni — Without passoutYear (optional field omitted)",
